<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roverrobotics_driver</name>
  <version>1.0.2</version>
  <description>
    ROS2 Wrapper for Rover Robots
  </description>
  <maintainer email="jack@roverrobotics.com">Jack Rivera</maintainer>
  <license>Apache-2.0</license>

  <author email="info@roverrobotics.com">Rover Robotics</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>rcpputils</depend>
  <depend>std_msgs</depend>
  <!-- <depend>rover_msgs</depend> -->
  <depend>tf2_geometry_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>libopencv-dev</depend>

  <!-- development -->

  <!-- ROS 2 API -->
  <depend>rclcpp_action</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_cpp</depend>
  <depend>tf2</depend>
  <depend>tf2_bullet</depend>

  <!-- YAML-CPP for config parsing -->
  <depend>yaml-cpp</depend>

  <!-- Core ROS2 dependencies -->
  <depend>visualization_msgs</depend>
  
  <!-- Computer vision dependencies -->
  <depend>cv_bridge</depend>
  <depend>opencv4</depend>
  
  <!-- Configuration and utilities -->
  <depend>yaml-cpp-vendor</depend>
  
  <!-- Eigen for mathematical operations -->
  <depend>eigen3_cmake_module</depend>

  <depend>std_srvs</depend>

  <!-- BehaviorTree (optional - uncomment if using) -->
  <!-- <depend>behaviortree_cpp_v3</depend> -->


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
